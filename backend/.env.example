PORT=4000
NODE_ENV=development

# Local: postgres://loloshop:password@localhost:5432/loloshop
# Neon:  postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/loloshop?sslmode=require
DATABASE_URL=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

OTP_TTL_SECONDS=300

ZENTRAMSG_API_KEY=
ZENTRAMSG_SENDER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LoloShop <noreply@loloshop.com>"

# Dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# PUBLIC_URL: base for upload URLs. Leave blank in dev (derives from request host).
PUBLIC_URL=

