PORT=4000
NODE_ENV=development

# Local: postgres://loloshop:password@localhost:5432/loloshop
# Production Neon example (non-production processes refuse this shared host):
# postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/loloshop?sslmode=require
DATABASE_URL=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

OTP_TTL_SECONDS=300

# Zentramsg WhatsApp OTP. API_KEY = x-api-token, DEVICE_UUID = sender device.
ZENTRAMSG_API_KEY=
ZENTRAMSG_DEVICE_UUID=
ZENTRAMSG_API_URL=https://api.zentramsg.com/v1/messages

# There is deliberately no master OTP and codes are never written to logs. Development
# must use an isolated gateway/database or a test harness that injects its own sender.

# Dev (localhost always allowed when NODE_ENV !== production)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Express trust-proxy value. `loopback` is correct for nginx on the same host.
# Set explicit proxy CIDRs if your reverse proxy is on another network.
TRUST_PROXY=loopback
# If you copy production CORS below, local npm run dev still works — server adds localhost in dev.
# PUBLIC_URL: base for upload URLs. Leave blank in dev (derives from request host).
PUBLIC_URL=

# --- Production (lolo-shop96.com) ---
# NODE_ENV=production
# FRONTEND_URL=https://lolo-shop96.com
# CORS_ORIGIN=https://lolo-shop96.com,https://www.lolo-shop96.com
# PUBLIC_URL=https://lolo-shop96.com

# Private staff portal — secret key that must appear in the login URL (/s/<key>).
# Generate portal/board keys with: openssl rand -hex 24
# Leave empty to disable the portal entirely.
STAFF_PORTAL_KEY=

# Private workshop portal — secret key that must appear in /w/<key>.
# Leave empty to disable the workshop portal entirely.
WORKSHOP_PORTAL_KEY=

# Private design-team portal — secret key that must appear in /d/<key>.
# Leave empty to disable the design-team portal entirely.
DESIGN_TEAM_PORTAL_KEY=

# Read-only TV production board — secret key passed in its private URL/API requests.
TV_BOARD_KEY=

# Optional fallback for revealing money fields when no money-gate secret is stored in DB.
MONEY_GATE_SECRET=

# OpenRouter — used by BOTH the Arabic calligraphy image tool (lib/openrouter.js) and the
# AI assistant (lib/aiChat.js). One key, two surfaces.
OPENROUTER_API_KEY=

# --- AI ASSISTANT (migration 078) -------------------------------------------
# Support chatbot + admin analytics. With OPENROUTER_API_KEY unset both endpoints return
# 503 and the UI hides itself — nothing else changes.
#
# Model: live-tested for Iraqi Arabic 2026-08-10. google/gemini-2.5-flash-lite answered
# correctly and sub-second at ~$0.04 per 1,000 messages. openai/gpt-oss-120b HALLUCINATED a
# delivery promise and must not be used here. Re-test before changing this.
AI_CHAT_MODEL=google/gemini-2.5-flash-lite
# Cost caps — all optional, defaults shown. Measured 2026-08-12: a real conversation costs
# ~$0.0001 per message, so the ceiling below is ~30,000 messages/day. It is an abuse backstop,
# NOT a budget; the per-user/per-session counts are what a real student actually feels.
AI_CHAT_DAILY_USD_MAX=3.0
# Warn the owner long before the wall. Fires an admin notification (which the push outbox turns
# into a phone push) the first time 24h spend crosses this, at most once per 24h. $1 is ~30× a
# normal day, so crossing it means something is wrong and two thirds of the budget is still
# left to react in. Set to 0 to disable the warning.
AI_CHAT_DAILY_USD_WARN=1.0
# The slice of that ceiling ANONYMOUS traffic may take. Availability, not cost: without the
# split, a flood of signed-out requests exhausts the day's budget and the assistant then
# refuses SIGNED-IN students too. Keep it below AI_CHAT_DAILY_USD_MAX.
AI_CHAT_ANON_DAILY_USD_MAX=1.2
AI_CHAT_USER_DAILY_MAX=60
AI_CHAT_ANON_DAILY_MAX=25
AI_CHAT_MAX_QUESTION_CHARS=600
AI_CHAT_MAX_OUTPUT_TOKENS=300
AI_CHAT_TIMEOUT_MS=20000
# How many anonymous session identities one IP may mint per hour (lib/anonSession.js). Bounds
# identity HARVESTING only — the per-IP request limiter already caps one address at 100 asks per
# 15 minutes however many identities it holds. Deliberately generous because CGNAT makes this
# the dangerous one: a rep drops a WhatsApp link and a hundred students open the site on one
# carrier NAT, each browser minting once. Measured 2026-08-12: 30/hour was tight enough to trip
# the project's own scenario harness.
AI_CHAT_SESSION_MINTS_PER_HOUR=300
# Where «تواصل مع الفريق» sends a customer the assistant could not help. Digits only, full
# international form, no + or spaces (e.g. 9647XXXXXXXXX). Unset → the escalation falls back to
# the Instagram page, which is always correct.
SHOP_WHATSAPP=

# --- PUSH NOTIFICATIONS (migration 077) -------------------------------------
# Both halves are optional and independent: with neither set the API never sends a push and
# notifications stay in-app only, exactly as they did before. Set one and that platform starts
# working on its own. Only notifications created in the LAST 15 MINUTES are ever pushed, so
# turning this on cannot replay the backlog.
#
# ANDROID — Firebase service account JSON (Firebase console → Project settings → Service
# accounts → Generate new private key). Either paste the whole file as one line, or point at a
# path readable only by the API user. This is a full Google credential: never commit it.
#   FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
FCM_SERVICE_ACCOUNT_FILE=
#
# iOS — APNs auth key (.p8) from developer.apple.com → Keys. Downloadable ONCE.
# ⚠️ The app talks to Apple directly, not through Firebase — see the header of
# backend/lib/push.js for why. The key belongs here even if it was also uploaded to Firebase.
# APNS_KEY_P8 takes the PEM inline (newlines may be written as \n); APNS_KEY_FILE takes a path.
APNS_KEY_FILE=
APNS_KEY_ID=
# 10 characters, Apple Developer → Membership. Falls back to IOS_TEAM_ID if that is already set.
APNS_TEAM_ID=
# Only change these if the bundle id changes or you are testing an Xcode development build:
# APNS_BUNDLE_ID=com.loloshop96.app
# APNS_ENV=sandbox

# Comma-separated Iraqi phone allow-list for demo login without WhatsApp OTP.
# It is inert unless DEMO_LOGIN_EXPIRES_AT is a valid future ISO timestamp no more than
# 30 days away. Keep both empty except during a specific app-store review window.
DEMO_LOGIN_PHONES=
DEMO_LOGIN_EXPIRES_AT=
