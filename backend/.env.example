PORT=4000
NODE_ENV=development

# Local: postgres://loloshop:password@localhost:5432/loloshop
# Production Neon example (non-production processes refuse this shared host):
# postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/loloshop?sslmode=require
DATABASE_URL=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

OTP_TTL_SECONDS=300

# Zentramsg WhatsApp OTP. API_KEY = x-api-token, DEVICE_UUID = sender device.
ZENTRAMSG_API_KEY=
ZENTRAMSG_DEVICE_UUID=
ZENTRAMSG_API_URL=https://api.zentramsg.com/v1/messages

# There is deliberately no master OTP and codes are never written to logs. Development
# must use an isolated gateway/database or a test harness that injects its own sender.

# Dev (localhost always allowed when NODE_ENV !== production)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Express trust-proxy value. `loopback` is correct for nginx on the same host.
# Set explicit proxy CIDRs if your reverse proxy is on another network.
TRUST_PROXY=loopback
# If you copy production CORS below, local npm run dev still works — server adds localhost in dev.
# PUBLIC_URL: base for upload URLs. Leave blank in dev (derives from request host).
PUBLIC_URL=

# --- Production (lolo-shop96.com) ---
# NODE_ENV=production
# FRONTEND_URL=https://lolo-shop96.com
# CORS_ORIGIN=https://lolo-shop96.com,https://www.lolo-shop96.com
# PUBLIC_URL=https://lolo-shop96.com

# Private staff portal — secret key that must appear in the login URL (/s/<key>).
# Generate portal/board keys with: openssl rand -hex 24
# Leave empty to disable the portal entirely.
STAFF_PORTAL_KEY=

# Private workshop portal — secret key that must appear in /w/<key>.
# Leave empty to disable the workshop portal entirely.
WORKSHOP_PORTAL_KEY=

# Private design-team portal — secret key that must appear in /d/<key>.
# Leave empty to disable the design-team portal entirely.
DESIGN_TEAM_PORTAL_KEY=

# Read-only TV production board — secret key passed in its private URL/API requests.
TV_BOARD_KEY=

# Optional fallback for revealing money fields when no money-gate secret is stored in DB.
MONEY_GATE_SECRET=

# OpenRouter image generation used by the Arabic calligraphy tool.
OPENROUTER_API_KEY=

# Comma-separated Iraqi phone allow-list for demo login without WhatsApp OTP.
# It is inert unless DEMO_LOGIN_EXPIRES_AT is a valid future ISO timestamp no more than
# 30 days away. Keep both empty except during a specific app-store review window.
DEMO_LOGIN_PHONES=
DEMO_LOGIN_EXPIRES_AT=
