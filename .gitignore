# dependencies
node_modules/
*/node_modules/

# env / secrets — NEVER commit
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# next.js
.next/
*/.next/
out/

# build / cache
dist/
*.tsbuildinfo
*/tsconfig.tsbuildinfo

# uploaded media (user content, lives on the server disk)
uploads/*
!uploads/.gitkeep
!uploads/logos/.gitkeep
!uploads/images/.gitkeep
!uploads/fonts/.gitkeep

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# agent + skill scaffolding
.claude/
.impeccable/
frontend/.impeccable/

# local DB dumps / backups (contain real customer PII — NEVER commit/push)
*_db_backup_*.json
prod_db_backup*.json
backups/
*_backup_*.sql
*_backup_*.sql.gz
*_backup_*.dump
*_backup_*.tar
*_backup_*.tar.gz
*_backup_*.zip

# Local-only session/docs artifacts — never commit
TESTING-WALKTHROUGH.md
SECURITY_AUDIT_REPORT_*.md
STAFF_ADMIN_READINESS.md
design-mockups/
voice_*

# Local dev auth helpers — dev-token-tmp.json holds a LIVE admin JWT and
# public/ is served in production. Never commit these.
frontend/public/dev-login.html
frontend/public/dev-token-tmp.json

# Brainstorming visual-companion scratch
.superpowers/

# showme verify screenshots — evidence for one session, regenerated on the next run
.showme/

# Reel render outputs. The KIT is tracked (store-assets/shared/, each reel's
# index.html + music.py + sheet.png); the rendered artefacts are not. All three
# regenerate from the commands in store-assets/README.md — a 15 s reel is ~1 min
# of headless Chrome, and `frames/` alone is ~170 MB while the disk sits at 95%.
store-assets/*.mp4
store-assets/*.mp4.part
store-assets/loloshop-reel-cover.jpg
store-assets/**/bed.wav
store-assets/**/frames/
store-assets/**/probe/
__pycache__/

# Verify-session screenshot evidence — same class as .showme/ above: proof for one
# session, regenerated by the next run, ~2 MB of PNG per pass. The findings live in
# docs/superpowers/specs/, which is what a later reader actually needs.
.verify-*/

# App Store / Play screenshots. These are RELEASE ARTEFACTS, not source: the copies
# that matter are the ones uploaded to App Store Connect, and the set is ~23 MB of
# PNG per submission. Regenerate from the live site rather than carrying every past
# submission's frames in the tree forever.
appstore/
