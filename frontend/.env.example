# Public API origin used by the browser build.
# Dev: http://localhost:4000
# Production: https://lolo-shop96.com
# Do not include a trailing /api — axios adds /api automatically.
NEXT_PUBLIC_API_URL=https://lolo-shop96.com

# Google Play / Trusted Web Activity Digital Asset Links.
# Keep the package name stable after publishing.
ANDROID_PACKAGE_NAME=com.loloshop96.app

# Add the Play App Signing SHA-256 fingerprint after creating the Play release.
# Multiple fingerprints can be comma-separated.
ANDROID_SHA256_CERT_FINGERPRINTS=
