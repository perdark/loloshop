# Public API origin used by the browser build.
# Dev: http://localhost:4000
# Production: https://lolo-shop96.com
# Do not include a trailing /api — axios adds /api automatically.
NEXT_PUBLIC_API_URL=https://lolo-shop96.com

# Google Play / Trusted Web Activity Digital Asset Links.
# Keep the package name stable after publishing.
ANDROID_PACKAGE_NAME=com.loloshop96.app

# Add the Play App Signing SHA-256 fingerprint after creating the Play release.
# Multiple fingerprints can be comma-separated.
#
# ⚠️ Take it from Play Console → Test and release → Setup → App integrity → App signing key
# certificate. NOT the local upload keystore: Play re-signs the AAB, so the upload key's
# fingerprint never matches and /join/ deep links keep opening in the browser instead of the
# app — silently, because App Links fail soft. 64 hex chars; a SHA-1 value is rejected.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Apple Team ID (10 alphanumeric chars) for the iOS Universal Links file served at
# /.well-known/apple-app-site-association. developer.apple.com → Account → Membership details.
# Unset = that route 404s and iOS deep links stay off; nothing else is affected.
IOS_TEAM_ID=
